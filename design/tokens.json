    "glasses": "#1C1C1E"
  },
  "font": {
    "family.ui": "-apple-system, 'SF Pro Text', 'PingFang SC', 'Helvetica Neue', system-ui, sans-serif",
    "family.display": "-apple-system, 'SF Pro Display', 'PingFang SC', system-ui, sans-serif",
    "family.mono": "'SF Mono', 'JetBrains Mono', Menlo, monospace",
    "family.android": "Roboto / Noto Sans SC (system default)",
    "weight.regular": 400,
    "weight.medium": 500,
    "weight.semibold": 600,
    "weight.bold": 700
  },
  "type": {
    "$comment": "[size, lineHeight, weight, letterSpacing]",
    "desktop": {
      "caption":  [11, 14, 400, 0.1],
      "footnote": [12, 16, 400, 0],
      "body":     [13, 18, 400, 0],
      "message":  [14, 20, 400, 0],
      "callout":  [13, 18, 500, 0],
      "title":    [15, 20, 600, -0.1],
      "headline": [17, 22, 600, -0.2],
      "large":    [22, 28, 700, -0.3],
      "display":  [28, 34, 700, -0.4],
      "mono":     [12, 18, 400, 0]
    },
    "mobile": {
      "caption":  [12, 16, 400, 0],
      "footnote": [13, 18, 400, 0],
      "body":     [15, 21, 400, 0],
      "message":  [16, 22, 400, 0],
      "callout":  [15, 20, 500, 0],
      "title":    [17, 22, 600, -0.2],
      "headline": [20, 25, 600, -0.3],
      "large":    [28, 34, 700, -0.4],
      "display":  [34, 41, 700, -0.5],
      "mono":     [13, 19, 400, 0]
    }
  },
  "space": { "0": 0, "1": 2, "2": 4, "3": 6, "4": 8, "5": 12, "6": 16, "7": 20, "8": 24, "9": 32, "10": 40, "11": 48, "12": 64 },
  "radius": { "xs": 4, "sm": 6, "md": 8, "lg": 12, "xl": 16, "2xl": 20, "bubble": 16, "bubble.tail": 6, "card": 12, "sheet": 20, "window": 12, "pill": 999 },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(0,0,0,0.06)",
    "2": "0 2px 8px var(--shadow-color), 0 0 0 0.5px var(--border-subtle)",
    "3": "0 8px 24px var(--shadow-color), 0 0 0 0.5px var(--border-default)",
    "4": "0 20px 60px var(--shadow-color), 0 0 0 0.5px var(--border-default)"
  },
  "motion": {
    "duration.instant": 80,
    "duration.fast": 120,
    "duration.normal": 200,
    "duration.slow": 320,
    "ease.standard": "cubic-bezier(0.2, 0, 0, 1)",
    "ease.decelerate": "cubic-bezier(0, 0, 0, 1)",
    "ease.accelerate": "cubic-bezier(0.3, 0, 1, 1)",
    "spring.sheet": "stiffness 380, damping 34",
    "spin.working": "1200ms linear infinite"
  },
