  "translucent": {
    "$comment": "Overrides applied on top of light/dark when material = translucent. blur/saturate apply to the surfaces listed. Content areas (chat, trace) stay near-opaque for legibility. Fallback when blur unsupported or 'Reduce transparency' is on: use the opaque theme.",
    "light": {
      "bg.window": "rgba(251,251,250,0.72)",
      "bg.sidebar": "rgba(243,243,241,0.58)",
      "bg.panel": "rgba(247,247,245,0.64)",
      "bg.chat": "rgba(239,239,235,0.86)",
      "bg.elevated": "rgba(255,255,255,0.78)",
      "bg.input": "rgba(255,255,255,0.80)"
    },
    "dark": {
      "bg.window": "rgba(24,24,26,0.70)",
      "bg.sidebar": "rgba(20,20,22,0.55)",
      "bg.panel": "rgba(26,26,29,0.62)",
      "bg.chat": "rgba(17,17,19,0.86)",
      "bg.elevated": "rgba(35,35,38,0.78)",
      "bg.input": "rgba(31,31,34,0.80)"
    },
    "blur.sidebar": 40,
    "blur.panel": 40,
    "blur.toolbar": 24,
    "blur.popover": 30,
    "saturate": 1.8
  },
  "avatar": {
    "$comment": "Bean avatar palette (10). bg = bean body, fg = eyes. Same in both themes. Main bot wears black-frame glasses (avatar.glasses).",
    "colors": ["#7C93B8", "#86A894", "#C6A47E", "#A08DBF", "#C48A8A", "#7FA9AE", "#B5A36C", "#9B9B9B", "#C49AB0", "#8C9BC4"],
