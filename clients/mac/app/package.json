    "test:question-blocks": "node --test src/components/questionBlockResolution.model.test.mjs src/components/questionCardAccessibility.test.mjs",
    "test:skill-message": "node --test src/components/skillMessage.model.test.mjs",
    "test:dashboard": "node --test src/components/dashboard.model.test.mjs",
