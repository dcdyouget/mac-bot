{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mac Bot",
  "version": "0.1.0",
  "identifier": "bot.mac.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Mac Bot",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [],
    "resources": {
      "../../crates/macbot-desktop/assets/Sounds/BubblePop.m4a": "Sounds/BubblePop.m4a"
    },
    "category": "Productivity",
    "shortDescription": "Mac Bot desktop client",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "../../packaging/Info.plist"
    }
  }
}
