<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.macbot.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__MACBOT_BIN__</string>
    <string>--port</string><string>7788</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>MACBOT_HOME</key><string>__MACBOT_HOME__</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__MACBOT_HOME__/data/macbot.log</string>
  <key>StandardErrorPath</key><string>__MACBOT_HOME__/data/macbot.log</string>
</dict>
</plist>
