{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workbench",
  "type": "object",
  "required": [
    "bots",
    "done_today",
    "global_limit",
    "running",
    "subagents_running",
    "waiting"
  ],
  "properties": {
    "bots": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/WorkbenchBot"
      }
    },
    "done_today": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Assignment"
      }
    },
    "global_limit": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "running": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "subagents_running": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "waiting": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/WorkbenchWaiting"
      }
    }
  },
  "definitions": {
    "Approval": {
      "type": "object",
      "required": [
        "bot_id",
        "chat_id",
        "created_at",
        "detail",
        "id",
        "risk",
        "state",
        "summary",
        "tool"
      ],
      "properties": {
        "assignment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "bot_id": {
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "decided_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "risk": {
          "$ref": "#/definitions/ApprovalRisk"
        },
        "state": {
          "$ref": "#/definitions/ApprovalState"
        },
        "summary": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        }
      }
    },
    "ApprovalRisk": {
      "type": "string",
      "enum": [
        "write",
        "exec",
        "external"
      ]
    },
    "ApprovalState": {
      "type": "string",
      "enum": [
        "pending",
        "allowed_once",
        "always_allowed",
        "denied",
        "expired"
      ]
    },
    "Assignment": {
      "type": "object",
      "required": [
        "bot_id",
        "created_at",
        "from",
        "id",
        "instruction",
        "model",
        "origin_chat_id",
        "status",
        "steers",
        "subagents_active",
        "title",
        "usage"
      ],
      "properties": {
        "bot_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "$ref": "#/definitions/Sender"
        },
        "id": {
          "type": "string"
        },
        "instruction": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "origin_chat_id": {
          "type": "string"
        },
        "parent_assignment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "queue_reason": {
          "anyOf": [
            {
              "$ref": "#/definitions/QueueReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_message_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/AssignmentStatus"
        },
        "steers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Steer"
          }
        },
        "subagents_active": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "title": {
          "type": "string"
        },
        "trigger_message_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "$ref": "#/definitions/UsageTotals"
        },
        "wait": {
          "anyOf": [
            {
              "$ref": "#/definitions/WaitState"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AssignmentStatus": {
      "type": "string",
      "enum": [
        "queued",
        "working",
        "waiting_user",
        "waiting_bot",
        "blocked",
        "done",
        "failed",
        "cancelled"
      ]
    },
    "Question": {
      "type": "object",
      "required": [
        "allow_free_text",
        "assignment_id",
        "bot_id",
        "chat_id",
        "id",
        "options",
        "state",
        "text"
      ],
      "properties": {
        "allow_free_text": {
          "type": "boolean"
        },
        "answer": {
          "anyOf": [
            {
              "$ref": "#/definitions/QuestionAnswer"
            },
            {
              "type": "null"
            }
          ]
        },
        "assignment_id": {
          "type": "string"
        },
        "bot_id": {
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state": {
          "$ref": "#/definitions/QuestionState"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "QuestionAnswer": {
      "type": "object",
      "required": [
        "at"
      ],
      "properties": {
        "at": {
          "type": "string"
        },
        "option_index": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "QuestionState": {
      "type": "string",
      "enum": [
        "pending",
        "answered"
      ]
    },
    "QueueReason": {
      "type": "string",
      "enum": [
        "bot_parallel_limit",
        "global_limit",
        "serial_in_project"
      ]
    },
    "Sender": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "user"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bot_id",
            "kind"
          ],
          "properties": {
            "bot_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "bot"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "system"
              ]
            }
          }
        }
      ]
    },
    "Steer": {
      "type": "object",
      "required": [
        "at",
        "message_id",
        "text"
      ],
      "properties": {
        "applied_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "UsageTotals": {
      "type": "object",
      "required": [
        "cache_read_tokens",
        "cache_write_tokens",
        "input_tokens",
        "output_tokens",
        "requests"
      ],
      "properties": {
        "cache_read_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "cache_write_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "cost": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "WaitReason": {
      "type": "string",
      "enum": [
        "decision",
        "blocked",
        "approval",
        "takeover"
      ]
    },
    "WaitState": {
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "message_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "$ref": "#/definitions/WaitReason"
        }
      }
    },
    "WorkbenchBot": {
      "type": "object",
      "required": [
        "active",
        "assignments",
        "bot_id",
        "max_parallel"
      ],
      "properties": {
        "active": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "assignments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Assignment"
          }
        },
        "bot_id": {
          "type": "string"
        },
        "max_parallel": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "WorkbenchWaiting": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "project_id",
            "since"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "review"
              ]
            },
            "project_id": {
              "type": "string"
            },
            "since": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "approval",
            "kind"
          ],
          "properties": {
            "approval": {
              "$ref": "#/definitions/Approval"
            },
            "kind": {
              "type": "string",
              "enum": [
                "approval"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "question"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "question"
              ]
            },
            "question": {
              "$ref": "#/definitions/Question"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "assignment_id",
            "bot_id",
            "kind",
            "reason"
          ],
          "properties": {
            "assignment_id": {
              "type": "string"
            },
            "bot_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "takeover"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
