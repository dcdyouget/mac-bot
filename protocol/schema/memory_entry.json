{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemoryEntry",
  "type": "object",
  "required": [
    "content",
    "created_at",
    "id",
    "source",
    "updated_at",
    "updated_by",
    "version"
  ],
  "properties": {
    "content": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "source": {
      "$ref": "#/definitions/MemorySource"
    },
    "updated_at": {
      "type": "string"
    },
    "updated_by": {
      "$ref": "#/definitions/Sender"
    },
    "version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "definitions": {
    "MemorySource": {
      "type": "object",
      "required": [
        "by"
      ],
      "properties": {
        "by": {
          "$ref": "#/definitions/Sender"
        },
        "chat_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "message_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Sender": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "user"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bot_id",
            "kind"
          ],
          "properties": {
            "bot_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "bot"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "system"
              ]
            }
          }
        }
      ]
    }
  }
}
