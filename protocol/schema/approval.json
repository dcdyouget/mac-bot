{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Approval",
  "type": "object",
  "required": [
    "bot_id",
    "chat_id",
    "created_at",
    "detail",
    "id",
    "risk",
    "state",
    "summary",
    "tool"
  ],
  "properties": {
    "assignment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "bot_id": {
      "type": "string"
    },
    "chat_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "decided_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "detail": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "risk": {
      "$ref": "#/definitions/ApprovalRisk"
    },
    "state": {
      "$ref": "#/definitions/ApprovalState"
    },
    "summary": {
      "type": "string"
    },
    "tool": {
      "type": "string"
    }
  },
  "definitions": {
    "ApprovalRisk": {
      "type": "string",
      "enum": [
        "write",
        "exec",
        "external"
      ]
    },
    "ApprovalState": {
      "type": "string",
      "enum": [
        "pending",
        "allowed_once",
        "always_allowed",
        "denied",
        "expired"
      ]
    }
  }
}
