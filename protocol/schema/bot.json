{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bot",
  "type": "object",
  "required": [
    "avatar",
    "browser_mode",
    "created_at",
    "description",
    "dm_chat_id",
    "hidden",
    "id",
    "is_main",
    "label",
    "max_parallel",
    "name",
    "notifications",
    "pinned",
    "status",
    "tools",
    "updated_at"
  ],
  "properties": {
    "avatar": {
      "$ref": "#/definitions/Avatar"
    },
    "browser_mode": {
      "$ref": "#/definitions/BrowserMode"
    },
    "created_at": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "dm_chat_id": {
      "type": "string"
    },
    "hidden": {
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "is_main": {
      "type": "boolean"
    },
    "label": {
      "type": "string"
    },
    "max_parallel": {
      "type": "integer",
      "format": "uint8",
      "minimum": 0.0
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "notifications": {
      "type": "boolean"
    },
    "pinned": {
      "type": "boolean"
    },
    "status": {
      "$ref": "#/definitions/BotStatus"
    },
    "tools": {
      "$ref": "#/definitions/ToolToggles"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "definitions": {
    "Avatar": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "color",
            "kind"
          ],
          "properties": {
            "color": {
              "type": "integer",
              "format": "uint8",
              "minimum": 0.0
            },
            "kind": {
              "type": "string",
              "enum": [
                "bean"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "emoji",
            "kind"
          ],
          "properties": {
            "emoji": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "emoji"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "file",
            "kind"
          ],
          "properties": {
            "file": {
              "$ref": "#/definitions/FileRef"
            },
            "kind": {
              "type": "string",
              "enum": [
                "image"
              ]
            }
          }
        }
      ]
    },
    "BotStatus": {
      "type": "object",
      "required": [
        "active",
        "queued",
        "summary",
        "waiting"
      ],
      "properties": {
        "active": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "queued": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "summary": {
          "$ref": "#/definitions/BotSummary"
        },
        "waiting": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "BotSummary": {
      "type": "string",
      "enum": [
        "idle",
        "working",
        "waiting_user",
        "blocked"
      ]
    },
    "BrowserMode": {
      "type": "string",
      "enum": [
        "headless",
        "headless_profile",
        "attach"
      ]
    },
    "FileRef": {
      "type": "object",
      "required": [
        "mime",
        "name",
        "path",
        "root",
        "root_id",
        "size"
      ],
      "properties": {
        "mime": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "root": {
          "$ref": "#/definitions/FileRoot"
        },
        "root_id": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "FileRoot": {
      "type": "string",
      "enum": [
        "project",
        "bot",
        "upload"
      ]
    },
    "ToolToggles": {
      "type": "object",
      "required": [
        "bash",
        "browser",
        "files",
        "mcp",
        "subagent",
        "web"
      ],
      "properties": {
        "bash": {
          "type": "boolean"
        },
        "browser": {
          "type": "boolean"
        },
        "files": {
          "type": "boolean"
        },
        "mcp": {
          "type": "boolean"
        },
        "subagent": {
          "type": "boolean"
        },
        "web": {
          "type": "boolean"
        }
      }
    }
  }
}
