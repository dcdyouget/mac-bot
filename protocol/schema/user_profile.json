{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserProfile",
  "type": "object",
  "required": [
    "onboarded",
    "timezone",
    "updated_at",
    "updated_by",
    "version"
  ],
  "properties": {
    "identity": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "onboarded": {
      "type": "boolean"
    },
    "timezone": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "updated_by": {
      "$ref": "#/definitions/Sender"
    },
    "version": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "definitions": {
    "Sender": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "user"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bot_id",
            "kind"
          ],
          "properties": {
            "bot_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "bot"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "system"
              ]
            }
          }
        }
      ]
    }
  }
}
