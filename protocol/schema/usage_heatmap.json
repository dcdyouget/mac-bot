{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HeatmapResult",
  "anyOf": [
    {
      "$ref": "#/definitions/CalendarHeatmap"
    },
    {
      "$ref": "#/definitions/WeekhourHeatmap"
    }
  ],
  "definitions": {
    "CalendarDay": {
      "type": "object",
      "required": [
        "date",
        "requests",
        "tokens",
        "value"
      ],
      "properties": {
        "cost": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "date": {
          "type": "string"
        },
        "requests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "top_bot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "CalendarHeatmap": {
      "type": "object",
      "required": [
        "days",
        "thresholds"
      ],
      "properties": {
        "days": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CalendarDay"
          }
        },
        "thresholds": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        }
      }
    },
    "WeekhourHeatmap": {
      "type": "object",
      "required": [
        "matrix",
        "thresholds"
      ],
      "properties": {
        "matrix": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
          }
        },
        "thresholds": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        }
      }
    }
  }
}
