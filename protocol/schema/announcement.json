{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Announcement",
  "type": "object",
  "required": [
    "artifacts",
    "highlights",
    "members",
    "project_id",
    "updated_at"
  ],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Artifact"
      }
    },
    "highlights": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Highlight"
      }
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AnnouncementMember"
      }
    },
    "project_id": {
      "type": "string"
    },
    "text": {
      "default": "",
      "type": "string"
    },
    "text_updated_at": {
      "default": "",
      "type": "string"
    },
    "text_updated_by": {
      "default": {
        "kind": "user"
      },
      "allOf": [
        {
          "$ref": "#/definitions/Sender"
        }
      ]
    },
    "updated_at": {
      "type": "string"
    },
    "version": {
      "default": 0,
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "definitions": {
    "AnnouncementMember": {
      "type": "object",
      "required": [
        "bot_id",
        "role_note",
        "state"
      ],
      "properties": {
        "bot_id": {
          "type": "string"
        },
        "current_assignment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "role_note": {
          "type": "string"
        },
        "since": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/definitions/MemberState"
        }
      }
    },
    "Artifact": {
      "type": "object",
      "required": [
        "assignment_id",
        "bot_id",
        "created_at",
        "id",
        "kind",
        "path_or_url",
        "project_id",
        "title",
        "updated_at"
      ],
      "properties": {
        "assignment_id": {
          "type": "string"
        },
        "bot_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ArtifactKind"
        },
        "path_or_url": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      }
    },
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "file",
        "dir",
        "url"
      ]
    },
    "Highlight": {
      "type": "object",
      "required": [
        "at",
        "text"
      ],
      "properties": {
        "at": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "MemberState": {
      "type": "string",
      "enum": [
        "idle",
        "queued",
        "working",
        "waiting_user",
        "waiting_bot",
        "blocked",
        "done"
      ]
    },
    "Sender": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "user"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bot_id",
            "kind"
          ],
          "properties": {
            "bot_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "bot"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "system"
              ]
            }
          }
        }
      ]
    }
  }
}
