{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Device",
  "type": "object",
  "required": [
    "app_version",
    "device_name",
    "id",
    "last_seen_at",
    "platform"
  ],
  "properties": {
    "app_version": {
      "type": "string"
    },
    "device_name": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "last_seen_at": {
      "type": "string"
    },
    "platform": {
      "$ref": "#/definitions/Platform"
    },
    "push_token": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "Platform": {
      "type": "string",
      "enum": [
        "macos",
        "android",
        "ios"
      ]
    }
  }
}
